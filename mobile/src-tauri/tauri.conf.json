{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xyra",
  "version": "1.1.0",
  "identifier": "com.indagalab.xyra",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev:mobile",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm --dir .. build:mobile",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xyra",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
